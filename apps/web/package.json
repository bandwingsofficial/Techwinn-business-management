{
  "name": "@techwin/web",
  "version": "0.1.0",
  "private": true,
  "description": "Techwin admin web application (Next.js App Router).",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:api-url": "node --experimental-strip-types --test scripts/resolve-api-base-url.test.mjs",
    "test:proxy-headers": "node --experimental-strip-types --test scripts/proxy-headers.test.mjs",
    "test:proxy-route": "node --experimental-strip-types --test scripts/proxy-route.test.mjs",
    "test:proxy": "pnpm run test:proxy-headers && pnpm run test:proxy-route",
    "test:attendance-errors": "node --experimental-strip-types --test scripts/attendance-errors.test.mjs",
    "test:finalize-sign-in": "node --experimental-strip-types --test scripts/finalize-sign-in.test.mjs",
    "test:api-client-refresh": "node --experimental-strip-types --test scripts/api-client-refresh.test.mjs",
    "test:auth-lifecycle": "pnpm run test:finalize-sign-in && pnpm run test:api-client-refresh && pnpm run test:attendance-errors && pnpm run test:proxy"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "papaparse": "5.7.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "xlsx": "0.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.3.0",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
