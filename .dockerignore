# VCS / editor
.git
.github
.cursor
.vscode
.idea

# Local env and secrets — never bake into images
.env
.env.*
!.env.example
**/*.pem
**/*.key

# Dependencies and build outputs (rebuilt inside Docker)
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo
apps/api/src/generated

# Tests, coverage, caches
coverage
.tmp
**/.turbo
**/playwright-report
**/test-results

# Docs and non-runtime assets (images do not need them)
docs
*.md

# Logs and OS junk
*.log
.DS_Store
Thumbs.db

# Local helper scripts / temp files
tmp-*.mjs
apps/api/tmp-*.mjs
